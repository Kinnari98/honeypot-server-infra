---
## host_vars/hannibal.yml.example
##
## Kopioi tämä: cp host_vars/hannibal.yml.example host_vars/hannibal.yml
## Täytä omat arvosi hannibal.yml:ään.
## hannibal.yml on gitignored – se ei mene repoon.

# Hallinta kannattaa ohjata WireGuard-tunnelin läpi (esim. 10.50.50.1), jolloin
# NSG:hen ei tarvita sisääntulevaa SSH-sääntöä internetistä lainkaan. Julkinen IP
# toimii myös, mutta vaatii NSG-säännön hallintakoneen osoitteelle.
ansible_host:                 ""   # WireGuard-osoite tai palvelimen julkinen IP
ansible_user:                 "azureuser"
ansible_ssh_private_key_file: ""   # SSH-avaimen polku (esim. ~/.ssh/honeypot_ed25519)
ansible_python_interpreter:   /usr/bin/python3
