## host_vars/hannibal.yml.example
##
## Kopioi tämä: cp host_vars/hannibal.yml.example host_vars/hannibal.yml
## Täytä omat arvosi hannibal.yml:ään.
## hannibal.yml on gitignored – se ei mene repoon.

ansible_host:                 ""   # Palvelimen IP (esim. 20.240.193.148)
ansible_user:                 "azureuser"
ansible_ssh_private_key_file: ""   # SSH-avaimen polku (esim. ~/.ssh/honeypot_ed25519)
ansible_python_interpreter:   /usr/bin/python3
