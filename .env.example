# ─────────────────────────────────────────────────────────────────────────────
# .env.example – Vaadittavat ympäristömuuttujat
#
# Käyttö:
#   cp .env.example .env
#   # Täytä omat arvosi .env:ään
#   source .env
#   ansible-playbook -i inventory/hosts.yml playbooks/deploy.yml
#
# GitHub Actions: Aseta nämä repon Settings → Secrets and variables → Actions
# ─────────────────────────────────────────────────────────────────────────────

# ─── Palvelinyhteys ───────────────────────────────────────────────────────────
HONEYPOT_HOST=            # Palvelimen IP tai hostname (esim. 10.0.0.4)
SSH_PRIVATE_KEY_PATH=     # SSH-avaimen polku (esim. ~/.ssh/honeypot_ed25519)
ANSIBLE_REMOTE_USER=      # SSH-käyttäjä palvelimella (jätetään tyhjäksi → default azureuser)

# ─── Admin-pääsy ──────────────────────────────────────────────────────────────
ADMIN_SSH_PORT=           # Salaiset SSH-portti admin-käyttöön (esim. 51234)
ADMIN_SOURCE_IP=          # Admin-koneen IP – vain tästä IP:stä pääsee admin-portille

# ─── Honeypot-identiteetti ────────────────────────────────────────────────────
LURE_HOSTNAME=            # Palvelimen hostname hyökkääjälle (esim. prod-web01)

# ─── Azure-infrastruktuuri ────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=    # az account show --query id
AZURE_RESOURCE_GROUP=     # Resurssiryhmän nimi
AZURE_LOCATION=           # Azure-alue (esim. swedencentral)

# ─── Azure Monitor / Sentinel ─────────────────────────────────────────────────
# Löytyy: Azure Portal → Log Analytics Workspace → Agents
LOG_ANALYTICS_WORKSPACE_ID=
LOG_ANALYTICS_WORKSPACE_KEY=
